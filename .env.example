# Luma — client-side environment
# Copy to .env.local. These two values are PUBLIC by design (the anon key is
# safe to ship; RLS is the security boundary). Never put the service-role key
# in the client — it lives only in the Stripe webhook / server environment.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Stripe webhook — Phase 2). Do NOT prefix with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
