# Luma — environment
# Copy to .env.local. Values marked (public) are safe to ship to the browser;
# the anon key is public by design and RLS is the security boundary.

# ---- Client (public) -------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Serverless functions ONLY (api/create-checkout, api/stripe-webhook) ---
# Never prefix these with VITE_. Vercel exposes every env var to functions,
# so the webhook reuses VITE_SUPABASE_URL for the project origin.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe webhook endpoint (Dashboard → Developers → Webhooks):
#   https://<your-deployment>/api/stripe-webhook
# Events to send: checkout.session.completed, charge.refunded
# See docs/STRIPE.md for the full setup and a test-mode walkthrough.
